  "fileRules": [
    {
      "id": "EIQ8w",
      "name": "AMW rule",
      "match": "all",
      "conditions": [
        {
          "source": "path",
          "operator": "contains",
          "value": "AMW"
        },
        {
          "source": "extension",
          "operator": "!is",
          "value": "png"
        }
      ],
      "enabled": true,
      "icon": "lucide-bug"
    },
    {
      "id": "VCQcK",
      "name": "Images rule",
      "match": "any",
      "conditions": [
        {
          "source": "extension",
          "operator": "is",
          "value": "png"
        },
        {
          "source": "extension",
          "operator": "is",
          "value": "jpg"
        },
        {
          "source": "extension",
          "operator": "is",
          "value": "jpeg"
        }
      ],
      "enabled": true,
      "icon": "lucide-image"
    },
    {
      "id": "ijOlH",
      "name": "ML files",
      "match": "all",
      "conditions": [
        {
          "source": "path",
          "operator": "contains",
          "value": "Machine Learning"
        },
        {
          "source": "extension",
          "operator": "!is",
          "value": "png"
        },
        {
          "source": "extension",
          "operator": "!is",
          "value": "jpeg"
        },
        {
          "source": "extension",
          "operator": "!is",
          "value": "jpg"
        }
      ],
      "enabled": true,
      "icon": "viewIcon"
    },
    {
      "id": "eDCH9",
      "name": "IS2 files",
      "match": "all",
      "conditions": [
        {
          "source": "path",
          "operator": "contains",
          "value": "IS2"
        }
      ],
      "enabled": true,
      "icon": "lucide-file"
    }
  ],
  "folderRules": [
    {
      "id": "t21Pj",
      "name": "AMW Folder",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "contains",
          "value": "AMW"
        }
      ],
      "enabled": true,
      "icon": "lucide-folder",
      "color": "red"
    },
    {
      "id": "G4fvP",
      "name": "ML folder",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "contains",
          "value": "Machine Learning"
        }
      ],
      "enabled": true,
      "icon": "lucide-folder",
      "color": "blue"
